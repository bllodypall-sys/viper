{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viper-preview",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run prepare:web"
  },
  "assets": {
    "directory": "./www",
    "not_found_handling": "404-page"
  }
}
